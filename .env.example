# --- First-party click tracking (admin/clicks) ---
# Neon Postgres connection string for THIS site (separate DB per site).
# Leave empty to disable tracking + report (code gracefully no-ops).
DATABASE_URL=

# Password to access /admin/clicks report (login gate). Required for login.
ADMIN_CLICKS_PASSWORD=

# Secret used to salt IP hashes and derive the admin session token.
# Set to a long random string in production.
CLICK_PEPPER=
